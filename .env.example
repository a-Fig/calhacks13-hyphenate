# Copy to .env (untracked) and fill in. Never commit real values.

# ERPNext (Bowman's ERP). See bowman/erp/NOTES.md.
# Base URL as seen from the laptop, through the SSH tunnel to the home server.
ERPNEXT_URL=
# Login for the Administrator account. bowman/erp/up.sh generates it if empty.
ERPNEXT_ADMIN_PASSWORD=
# API key and secret of the Norn Agent user (norn@bowman.example), written by bowman/erp/bootstrap.mjs.
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# user@host of the Mac that runs ERPNext, used by bowman/erp/up.sh. Kept out of the repo on purpose.
BOWMAN_ERP_SSH=

# Bowman's PLM (a Frappe site). See bowman/plm/NOTES.md.
# Base URL as seen from the laptop, through the SSH tunnel to the home server.
PLM_URL=
# Login for the PLM's Administrator account. bowman/plm/up.sh generates it if empty.
PLM_ADMIN_PASSWORD=
# API key and secret of the Norn integration user (norn@bowman-aviation.example), written by bowman/plm/setup.ts.
PLM_API_KEY=
PLM_API_SECRET=
# One password shared by Bowman's 18 fictional users in the PLM, generated by bowman/plm/setup.ts.
PLM_USER_PASSWORD=
# HMAC secret the PLM signs its webhooks with (header X-Frappe-Webhook-Signature), generated by setup.ts.
PLM_WEBHOOK_SECRET=
# Where the PLM sends NCR, ECR and ECO webhooks. Empty keeps them disabled. Set it, then re-run bowman/plm/setup.ts.
NORN_WEBHOOK_URL=
# user@host of the Mac that runs the PLM (and the ERP), used by bowman/plm/up.sh. Falls back to BOWMAN_ERP_SSH. Kept out of the repo on purpose.
BOWMAN_PLM_SSH=
