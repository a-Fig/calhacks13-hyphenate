# Copy to .env (untracked) and fill in. Never commit real values.

# ERPNext (Bowman's ERP). See bowman/erp/NOTES.md.
# Base URL as seen from the laptop, through the SSH tunnel to the home server.
ERPNEXT_URL=
# Login for the Administrator account. bowman/erp/up.sh generates it if empty.
ERPNEXT_ADMIN_PASSWORD=
# API key and secret of the Norn Agent user (norn@bowman.example), written by bowman/erp/bootstrap.mjs.
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# user@host of the Mac that runs ERPNext, used by bowman/erp/up.sh. Kept out of the repo on purpose.
BOWMAN_ERP_SSH=
