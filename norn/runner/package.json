{
  "name": "@norn/runner",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Norn agent runner: runs one job as one Claude Code session through the Claude Agent SDK",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
